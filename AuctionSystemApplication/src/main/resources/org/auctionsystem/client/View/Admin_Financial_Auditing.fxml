<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="620.0" prefWidth="960.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.auctionsystem.client.Controller.Admin.Controller_Admin_Financial_Auditing">

   <top>
      <VBox BorderPane.alignment="TOP_LEFT">
         <children>
            <!-- Tiêu đề -->
            <Label prefHeight="44.0" prefWidth="960.0" text="KIỂM SOÁT TÀI CHÍNH" wrapText="true">
               <font>
                  <Font name="Times New Roman Bold" size="28.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="6.0" left="10.0" top="10.0" />
               </VBox.margin>
            </Label>

            <!-- Thanh tìm kiếm theo username -->
            <HBox alignment="CENTER_LEFT" spacing="8.0" prefHeight="46.0">
               <VBox.margin>
                  <Insets left="10.0" right="10.0" bottom="4.0" />
               </VBox.margin>
               <Label text="Tài khoản:" minWidth="80.0">
                  <font><Font size="13.0" /></font>
               </Label>
               <TextField fx:id="field_search_user" prefWidth="220.0" promptText="Nhập username...">
                  <font><Font size="13.0" /></font>
               </TextField>
               <Button fx:id="btn_search" mnemonicParsing="false" onAction="#searchByUser" text="🔍 Tra cứu">
                  <font><Font size="13.0" /></font>
               </Button>
               <Label fx:id="lbl_status" text="" wrapText="true" HBox.hgrow="ALWAYS">
                  <font><Font size="13.0" /></font>
               </Label>
            </HBox>

            <!-- Bộ lọc loại giao dịch + khoảng ngày -->
            <HBox alignment="CENTER_LEFT" spacing="10.0" prefHeight="42.0">
               <VBox.margin>
                  <Insets left="10.0" right="10.0" bottom="6.0" />
               </VBox.margin>
               <Label text="Loại GD:" minWidth="80.0">
                  <font><Font size="13.0" /></font>
               </Label>
               <ComboBox fx:id="ComboBox_TransactionType" prefWidth="200.0">
                  <font><Font size="13.0" /></font>
               </ComboBox>
               <Label text="Từ ngày:">
                  <font><Font size="13.0" /></font>
               </Label>
               <DatePicker fx:id="datePicker_from" prefWidth="145.0" promptText="Từ ngày" />
               <Label text="Đến ngày:">
                  <font><Font size="13.0" /></font>
               </Label>
               <DatePicker fx:id="datePicker_to" prefWidth="145.0" promptText="Đến ngày" />
               <Button mnemonicParsing="false" onAction="#clearFilters" text="✖ Xóa bộ lọc">
                  <font><Font size="13.0" /></font>
               </Button>
            </HBox>
         </children>
      </VBox>
   </top>

   <center>
      <TableView fx:id="tableTransactions" prefHeight="400.0"
                 BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="col_transactionId" prefWidth="100.0" text="Mã GD" />
            <TableColumn fx:id="col_account"        prefWidth="140.0" text="Tài khoản (ID)" />
            <TableColumn fx:id="col_product"        prefWidth="180.0" text="Sản phẩm" />
            <TableColumn fx:id="col_type"           prefWidth="140.0" text="Loại giao dịch" />
            <TableColumn fx:id="col_amount"         prefWidth="130.0" text="Số tiền" />
            <TableColumn fx:id="col_time"           prefWidth="160.0" text="Thời gian" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <placeholder>
            <Label text="Nhập username và nhấn 🔍 Tra cứu để xem lịch sử giao dịch" />
         </placeholder>
      </TableView>
   </center>

   <bottom>
      <HBox alignment="CENTER" prefHeight="46.0" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets top="10.0" />
         </BorderPane.margin>
         <children>
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#back_to_admin_dashboard"
                    prefHeight="30.0" prefWidth="160.0" text="← Quay lại trang chủ">
               <font><Font size="13.0" /></font>
            </Button>
            <Region HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </bottom>

   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="0.0" />
   </padding>
</BorderPane>
