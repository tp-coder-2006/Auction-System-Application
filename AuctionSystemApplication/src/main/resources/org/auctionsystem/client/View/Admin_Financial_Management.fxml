                  <Font name="Times New Roman Bold" size="30.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </top>
   <center>
      <VBox prefHeight="454.0" prefWidth="895.0" styleClass="stat-card" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER" prefHeight="53.0" prefWidth="600.0">
               <children>
                  <ComboBox fx:id="ComboBox_TransactionType" prefHeight="35.0" prefWidth="130.0" promptText="Loại giao dịch" stylesheets="@../../CSS/ComboBox.css" />
