<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="960.0"
            stylesheets="@../../CSS/AdminMenu.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.auctionsystem.client.Controller.Admin.Controller_Admin_Financial_Auditing">

   <!-- ─── TOP: tiêu đề + bộ lọc ─────────────────────────────────────────── -->
   <top>
      <VBox spacing="10.0" styleClass="admin-card" BorderPane.alignment="CENTER">
         <padding><Insets bottom="12.0" left="20.0" right="20.0" top="12.0"/></padding>

         <!-- Tiêu đề -->
         <Label text="KIỂM SOÁT TÀI CHÍNH" maxWidth="1.7976931348623157E308">
            <font><Font name="Times New Roman Bold" size="28.0"/></font>
         </Label>

         <!-- Hàng 1: Lọc loại + khoảng ngày -->
         <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="Loại giao dịch:" style="-fx-font-size:13px;"/>
            <ComboBox fx:id="ComboBox_TransactionType" prefWidth="170.0" prefHeight="30.0"
                      stylesheets="@../../CSS/ComboBox.css"/>
            <Label text="Từ ngày:" style="-fx-font-size:13px;"/>
            <DatePicker fx:id="datePicker_from" prefWidth="150.0"
                        stylesheets="@../../CSS/DatePicker.css"/>
            <Label text="Đến ngày:" style="-fx-font-size:13px;"/>
            <DatePicker fx:id="datePicker_to" prefWidth="150.0"
                        stylesheets="@../../CSS/DatePicker.css"/>
            <Button mnemonicParsing="false" onAction="#clearFilters" text="✖ Xóa lọc"
                    style="-fx-font-size:12px;"/>
         </HBox>

         <!-- Hàng 2: Tìm theo username -->
         <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Label text="Tìm người dùng:" style="-fx-font-size:13px;"/>
            <TextField fx:id="field_search_user" prefWidth="280.0" prefHeight="30.0"
                       promptText="Nhập username cần tra cứu">
               <font><Font size="13.0"/></font>
            </TextField>
            <Button fx:id="btn_search" mnemonicParsing="false" onAction="#searchByUser"
                    prefHeight="30.0" prefWidth="90.0" text="🔍 Tìm kiếm">
               <font><Font size="13.0"/></font>
            </Button>
            <Button mnemonicParsing="false" onAction="#clearFilters"
                    prefHeight="30.0" prefWidth="90.0" text="🔄 Tải lại">
               <font><Font size="13.0"/></font>
            </Button>
            <Label fx:id="lbl_status" text="" style="-fx-font-size:12px;"/>
         </HBox>
      </VBox>
   </top>

   <!-- ─── CENTER: bảng giao dịch ───────────────────────────────────────── -->
   <center>
      <VBox VBox.vgrow="ALWAYS" BorderPane.alignment="CENTER">
         <BorderPane.margin><Insets top="8.0"/></BorderPane.margin>
         <TableView fx:id="tableTransactions"
                    maxWidth="1.7976931348623157E308"
                    VBox.vgrow="ALWAYS"
                    stylesheets="@../../CSS/TableView.css">
            <columns>
               <TableColumn fx:id="col_transactionId" text="Mã giao dịch"    prefWidth="220.0"/>
               <TableColumn fx:id="col_account"       text="Tài khoản"        prefWidth="130.0"/>
               <TableColumn fx:id="col_product"       text="Sản phẩm"         prefWidth="160.0"/>
               <TableColumn fx:id="col_type"          text="Loại giao dịch"   prefWidth="140.0"/>
               <TableColumn fx:id="col_amount"        text="Số tiền"          prefWidth="120.0"/>
               <TableColumn fx:id="col_time"          text="Thời gian"        prefWidth="150.0"/>
            </columns>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <placeholder>
               <Label text="Đang tải dữ liệu..."
                      style="-fx-text-fill:#888;-fx-font-size:13px;"/>
            </placeholder>
         </TableView>
      </VBox>
   </center>

   <!-- ─── BOTTOM: nút quay lại ─────────────────────────────────────────── -->
   <bottom>
      <HBox alignment="CENTER" BorderPane.alignment="CENTER">
         <BorderPane.margin><Insets top="10.0" bottom="6.0"/></BorderPane.margin>
         <Button mnemonicParsing="false" onAction="#back_to_admin_dashboard"
                 prefWidth="160.0" prefHeight="32.0" text="← Quay lại trang chủ">
            <font><Font size="13.0"/></font>
         </Button>
      </HBox>
   </bottom>

   <padding><Insets bottom="10.0" left="15.0" right="15.0" top="10.0"/></padding>
</BorderPane>
