<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1000.0" styleClass="stat-card" stylesheets="@../../CSS/AdminMenu.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.auctionsystem.client.Controller.Admin.Controller_Admin_Financial_Management">

   <!-- ─── TOP: tiêu đề + bộ lọc ─────────────────────────────────────────── -->
   <top>
      <VBox spacing="10.0" styleClass="admin-card" BorderPane.alignment="CENTER">
         <padding><Insets bottom="12.0" left="20.0" right="20.0" top="12.0" /></padding>

         <!-- Tiêu đề -->
         <Label maxWidth="1.7976931348623157E308" text="KIỂM SOÁT TÀI CHÍNH">
            <font><Font name="Times New Roman Bold" size="28.0" /></font>
         </Label>

         <!-- Hàng 1: Lọc loại + khoảng ngày -->
         <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label style="-fx-font-size:13px;" text="Loại giao dịch:" />
            <ComboBox fx:id="ComboBox_TransactionType" prefHeight="30.0" prefWidth="170.0" stylesheets="@../../CSS/ComboBox.css" />
            <Label style="-fx-font-size:13px;" text="Từ ngày:" />
            <DatePicker fx:id="datePicker_from" prefWidth="150.0" stylesheets="@../../CSS/DatePicker.css" />
            <Label style="-fx-font-size:13px;" text="Đến ngày:" />
            <DatePicker fx:id="datePicker_to" prefWidth="150.0" stylesheets="@../../CSS/DatePicker.css" />
            <Button mnemonicParsing="false" onAction="#clearFilters" style="-fx-font-size:12px;" styleClass="button-admin" stylesheets="@../../CSS/Button.css" text="✖ Xóa lọc" />
         </HBox>

         <!-- Hàng 2: Tìm theo username -->
         <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Label style="-fx-font-size:13px;" text="Tìm người dùng:" />
            <TextField fx:id="field_search_user" prefHeight="30.0" prefWidth="280.0" promptText="Nhập username cần tra cứu">
               <font><Font size="14.0" /></font>
            </TextField>
            <Button fx:id="btn_search" mnemonicParsing="false" onAction="#searchByUser" prefHeight="30.0" prefWidth="90.0" styleClass="button-admin" stylesheets="@../../CSS/Button.css" text="🔍 Tìm kiếm">
               <font><Font size="13.0" /></font>
            </Button>
            <Button mnemonicParsing="false" onAction="#clearFilters" prefHeight="30.0" prefWidth="90.0" styleClass="button-admin" stylesheets="@../../CSS/Button.css" text="🔄 Tải lại">
               <font><Font size="13.0" /></font>
            </Button>
            <Label fx:id="lbl_status" style="-fx-font-size:12px;" text="" />
         </HBox>
      </VBox>
   </top>

   <!-- ─── CENTER: bảng giao dịch ───────────────────────────────────────── -->
   <center>
      <VBox BorderPane.alignment="CENTER" VBox.vgrow="ALWAYS">
         <BorderPane.margin><Insets top="8.0" /></BorderPane.margin>
         <TableView fx:id="tableTransactions" maxWidth="1.7976931348623157E308" VBox.vgrow="ALWAYS">
            <columns>
               <TableColumn fx:id="col_transactionId" prefWidth="220.0" text="Mã giao dịch" />
               <TableColumn fx:id="col_account" prefWidth="130.0" text="Tài khoản" />
               <TableColumn fx:id="col_product" prefWidth="160.0" text="Sản phẩm" />
               <TableColumn fx:id="col_type" prefWidth="140.0" text="Loại giao dịch" />
               <TableColumn fx:id="col_amount" prefWidth="120.0" text="Số tiền" />
               <TableColumn fx:id="col_time" prefWidth="150.0" text="Thời gian" />
            </columns>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <placeholder>
               <Label style="-fx-text-fill:#888;-fx-font-size:13px;" text="Đang tải dữ liệu..." />
            </placeholder>
            <stylesheets>
               <URL value="@../../CSS/TableView.css" />
               <URL value="@../../CSS/style.css" />
            </stylesheets>
         </TableView>
      </VBox>
   </center>

   <!-- ─── BOTTOM: nút quay lại ─────────────────────────────────────────── -->
   <bottom>
      <HBox alignment="CENTER" BorderPane.alignment="CENTER">
         <BorderPane.margin><Insets top="10.0" /></BorderPane.margin>
         <Button mnemonicParsing="false" onAction="#back_to_admin_dashboard" prefHeight="40.0" prefWidth="205.0" stylesheets="@../../CSS/style.css" text="← Quay lại trang chủ">
            <font><Font size="18.0" /></font>
         </Button>
      </HBox>
   </bottom>

   <padding><Insets bottom="10.0" left="15.0" right="15.0" top="10.0" /></padding>
</BorderPane>
