<BorderPane prefHeight="580.0" prefWidth="905.0" styleClass="admin-card" stylesheets="@../../CSS/AdminMenu.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.auctionsystem.client.Controller.Admin.Controller_Admin_Financial_Management">
   <top>
      <VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefHeight="36.0" prefWidth="895.0" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Label maxWidth="1.7976931348623157E308" style="-fx-text-fill: #523902;" text="KIỂM SOÁT TÀI CHÍNH" wrapText="true">
