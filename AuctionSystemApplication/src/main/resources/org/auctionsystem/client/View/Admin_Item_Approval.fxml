<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.auctionsystem.client.Controller.Admin.Controller_Admin_Item_Approval">
   <children>
      <Label text="DANH SÁCH SẢN PHẨM CẦN DUYỆT" wrapText="true">
         <font>
            <Font name="Times New Roman Bold" size="24.0" />
         </font>
      </Label>
      <HBox maxHeight="-Infinity" maxWidth="1.7976931348623157E308" prefHeight="20.0" prefWidth="800.0" VBox.vgrow="ALWAYS">
         <children>
            <Region prefHeight="100.0" prefWidth="110.0" HBox.hgrow="ALWAYS" />
            <Label layoutX="10.0" layoutY="10.0" text="Lọc trạng thái:" wrapText="true">
               <font>
                  <Font name="Times New Roman Bold" size="24.0" />
               </font>
            </Label>
            <ComboBox prefHeight="26.0" prefWidth="165.0" promptText="Trạng thái sản phẩm" />
            <Region layoutX="10.0" layoutY="10.0" prefHeight="100.0" prefWidth="110.0" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <TableView maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="350.0" prefWidth="800.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn prefWidth="75.0" text="Tên sản phẩm" />
          <TableColumn prefWidth="75.0" text="Người bán" />
            <TableColumn prefWidth="75.0" text="Giá khởi điểm" />
            <TableColumn prefWidth="75.0" text="Thời gian bắt đầu/kết thúc" />
            <TableColumn prefWidth="75.0" text="Trạng thái" />
            <TableColumn prefWidth="75.0" text="Duyệt nhanh" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox prefHeight="0.0" prefWidth="800.0">
         <children>
            <Region layoutX="124.0" layoutY="10.0" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" prefHeight="100.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#back_to_admin_dashboard" text="Quay lại trang chủ" />
            <Region maxHeight="-Infinity" maxWidth="1.7976931348623157E308" prefHeight="100.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
