         <children>
            <Label prefHeight="34.0" prefWidth="930.0" style="-fx-text-fill: #523902;" stylesheets="@../../CSS/Label.css" text="QUẢN LÝ NGƯỜI DÙNG" wrapText="true">
               <font>
                  <Font name="Times New Roman Bold" size="30.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </top>
   <center>
      <VBox prefHeight="446.0" prefWidth="895.0" styleClass="stat-card" stylesheets="@../../CSS/style.css" BorderPane.alignment="CENTER">
         <children>
            <HBox prefHeight="68.0" prefWidth="600.0">
               <children>
                  <TextField prefHeight="26.0" prefWidth="282.0" promptText="Tìm tên người dùng" />
