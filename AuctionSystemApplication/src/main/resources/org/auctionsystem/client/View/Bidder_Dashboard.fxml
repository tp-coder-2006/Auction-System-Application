               <VBox.margin>
                  <Insets bottom="10.0" top="10.0" />
               </VBox.margin>
            </Label>
            <HBox alignment="CENTER" prefHeight="282.0" prefWidth="658.0">
               <children>
                  <VBox alignment="CENTER" prefHeight="245.0" prefWidth="594.0" spacing="10.0" styleClass="floating-card" stylesheets="@../../CSS/style.css">
                     <children>
                        <Button mnemonicParsing="false" onAction="#Go_to_searching_room" prefHeight="51.0" prefWidth="221.0" text="Đấu giá ngay!!!">
