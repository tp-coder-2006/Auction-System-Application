<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="580.0" prefWidth="905.0" spacing="20.0" stylesheets="@../../CSS/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.auctionsystem.client.Controller.Bidder.Controller_Bidding_History">
   <children>
      <Label prefHeight="34.0" prefWidth="848.0" stylesheets="@../../CSS/Label.css" text="LỊCH SỬ ĐẤU GIÁ" wrapText="true" VBox.vgrow="ALWAYS">
         <font>
            <Font name="Times New Roman Bold" size="30.0" />
         </font>
      </Label>
      <TableView fx:id="tableBiddingHistory" maxHeight="1.7976931348623157E308" prefHeight="451.0" prefWidth="697.0" stylesheets="@../../CSS/TableView.css" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="col_item_name" prefWidth="75.0" text="Tên sản phẩm" />
          <TableColumn fx:id="col_bid_price" prefWidth="75.0" text="Giá đã đặt" />
          <TableColumn fx:id="col_bid_time" prefWidth="75.0" text="Thời gian đặt" />

        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox alignment="BOTTOM_CENTER" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" prefHeight="67.0" prefWidth="602.0" VBox.vgrow="NEVER">
         <children>
            <Region layoutX="62.0" layoutY="10.0" prefHeight="0.0" prefWidth="242.0" HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#back_to_bidding_dashboard" text="Quay lại trang chủ">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            <Region prefHeight="0.0" prefWidth="222.0" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="30.0" right="30.0" top="30.0" />
   </padding>
</VBox>
