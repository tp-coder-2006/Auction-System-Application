<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" fitToHeight="false"
            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="my-background-pane"
            stylesheets="@../../CSS/background.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.auctionsystem.client.Controller.Bidder.Controller_Bidding_room">

   <content>
   <VBox spacing="0.0" minWidth="960.0" maxWidth="1100.0"
         style="-fx-alignment: center;">
      <padding>
         <Insets top="16.0" bottom="24.0" left="24.0" right="24.0" />
      </padding>

      <!-- ── Header: tên + badge + countdown ── -->
      <HBox alignment="CENTER_LEFT" spacing="16.0">
         <Label fx:id="lbl_product_name" styleClass="heading"
                stylesheets="@../../CSS/Label.css"
                text="Phòng đấu giá" wrapText="true" HBox.hgrow="ALWAYS">
            <font><Font name="System Bold" size="22.0" /></font>
         </Label>
         <Label text="🔴 LIVE" styleClass="status-badge"
                stylesheets="@../../CSS/Label.css" />
         <Label fx:id="lbl_time_remaining"
                styleClass="heading" stylesheets="@../../CSS/Label.css"
                text="⏰ —">
            <font><Font name="System Bold" size="14.0" /></font>
         </Label>
      </HBox>

      <Separator>
         <VBox.margin><Insets top="8.0" bottom="12.0" /></VBox.margin>
      </Separator>

      <!-- ── Thân: 2 cột ── -->
      <HBox spacing="24.0" VBox.vgrow="ALWAYS">

         <!-- ══ Cột trái: ảnh + thông tin item ══ -->
         <VBox spacing="10.0" minWidth="260.0" maxWidth="260.0">

            <StackPane styleClass="image-frame" stylesheets="@../../CSS/ImageView.css"
                       prefHeight="200.0" minHeight="200.0">
               <ImageView fx:id="productImageView"
                          fitHeight="200.0" fitWidth="260.0"
                          pickOnBounds="true" preserveRatio="true" />
            </StackPane>

            <Separator />

            <Label text="Giá khởi điểm:" styleClass="heading"
                   stylesheets="@../../CSS/Label.css">
               <font><Font name="System Bold" size="13.0" /></font>
            </Label>
            <Label fx:id="lbl_starting_price"
                   styleClass="heading" stylesheets="@../../CSS/Label.css">
               <font><Font size="13.0" /></font>
            </Label>

            <Label text="Giá cao nhất hiện tại:" styleClass="heading"
                   stylesheets="@../../CSS/Label.css">
               <font><Font name="System Bold" size="13.0" /></font>
            </Label>
            <Label fx:id="lbl_current_price"
                   styleClass="heading" stylesheets="@../../CSS/Label.css">
               <font><Font size="13.0" /></font>
            </Label>

            <Separator />

            <Label text="Số dư tài khoản:" styleClass="heading"
                   stylesheets="@../../CSS/Label.css">
               <font><Font name="System Bold" size="13.0" /></font>
            </Label>
            <Label fx:id="lbl_balance"
                   styleClass="heading" stylesheets="@../../CSS/Label.css">
               <font><Font size="13.0" /></font>
            </Label>

         </VBox>

         <!-- ══ Cột phải: đặt giá + lịch sử bid ══ -->
         <VBox spacing="10.0" HBox.hgrow="ALWAYS">

            <!-- Thông báo khi phiên kết thúc -->
            <Label fx:id="lbl_status_message"
                   styleClass="error-announcement" stylesheets="@../../CSS/Label.css"
                   wrapText="true" maxWidth="1.7976931348623157E308"
                   visible="false" managed="false">
               <font><Font size="14.0" /></font>
            </Label>

            <!-- ═══ KHU VỰC ĐẶT GIÁ ═══ -->
            <VBox fx:id="bid_panel" spacing="8.0">

               <Label text="Đặt giá" styleClass="heading"
                      stylesheets="@../../CSS/Label.css">
                  <font><Font name="System Bold" size="15.0" /></font>
               </Label>

               <!-- Bước giá tối thiểu -->
               <Label fx:id="lbl_increment"
                      styleClass="heading" stylesheets="@../../CSS/Label.css"
                      text="Bước giá tối thiểu: —">
                  <font><Font size="13.0" /></font>
               </Label>

               <!-- Nút tăng nhanh -->
               <FlowPane hgap="6.0" vgap="6.0" alignment="CENTER_LEFT">
                  <Button text="+10k"  onAction="#onQuickBid10k"  prefWidth="56.0"  styleClass="product-card" />
                  <Button text="+20k"  onAction="#onQuickBid20k"  prefWidth="56.0"  styleClass="product-card" />
                  <Button text="+50k"  onAction="#onQuickBid50k"  prefWidth="56.0"  styleClass="product-card" />
                  <Button text="+100k" onAction="#onQuickBid100k" prefWidth="62.0"  styleClass="product-card" />
                  <Button text="+500k" onAction="#onQuickBid500k" prefWidth="62.0"  styleClass="product-card" />
                  <Button text="+1tr"  onAction="#onQuickBid1tr"  prefWidth="50.0"  styleClass="product-card" />
                  <Button text="+2tr"  onAction="#onQuickBid2tr"  prefWidth="50.0"  styleClass="product-card" />
                  <Button text="+5tr"  onAction="#onQuickBid5tr"  prefWidth="50.0"  styleClass="product-card" />
               </FlowPane>

               <!-- Nhập giá + nút đặt -->
               <HBox spacing="10.0" alignment="CENTER_LEFT">
                  <TextField fx:id="field_bid_amount"
                             prefHeight="34.0" HBox.hgrow="ALWAYS"
                             promptText="Nhập số tiền đặt giá">
                     <font><Font size="14.0" /></font>
                  </TextField>
                  <Button fx:id="btn_bid" text="Đặt giá"
                          onAction="#onPlaceBid"
                          prefHeight="34.0" prefWidth="90.0">
                     <font><Font size="14.0" /></font>
                  </Button>
               </HBox>

               <!-- Thông báo lỗi đặt giá -->
               <Label fx:id="lbl_bid_error"
                      styleClass="error-announcement" stylesheets="@../../CSS/Label.css"
                      wrapText="true" maxWidth="1.7976931348623157E308">
                  <font><Font size="12.0" /></font>
               </Label>

               <Separator />

               <!-- ═══ AUTO BID ═══ -->
               <Label text="🤖 Đặt giá tự động" styleClass="heading"
                      stylesheets="@../../CSS/Label.css">
                  <font><Font name="System Bold" size="15.0" /></font>
               </Label>

               <!-- Container bo tròn -->
               <VBox spacing="8.0"
                     style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.12); -fx-border-radius: 8; -fx-padding: 12;">

                  <Label text="Giá trần tối đa" styleClass="heading"
                         stylesheets="@../../CSS/Label.css">
                     <font><Font size="12.0" /></font>
                  </Label>

                  <TextField fx:id="field_auto_max_price"
                             prefHeight="34.0"
                             promptText="Giá tôi đã bạn sẵn sàng trả">
                     <font><Font size="14.0" /></font>
                  </TextField>

                  <Label fx:id="lbl_auto_increment_hint"
                         styleClass="heading" stylesheets="@../../CSS/Label.css"
                         text="ℹ Mỗi lần tự động tăng 1 bước tối thiểu (—)">
                     <font><Font size="11.0" /></font>
                  </Label>

                  <Button fx:id="btn_auto_bid"
                          text="🤖 Kích hoạt Auto Bid"
                          onAction="#onToggleAutoBid"
                          prefHeight="36.0" maxWidth="1.7976931348623157E308">
                     <font><Font size="13.0" /></font>
                  </Button>

                  <Label fx:id="lbl_auto_bid_status"
                         styleClass="heading" stylesheets="@../../CSS/Label.css"
                         text="" visible="false" managed="false" wrapText="true"
                         maxWidth="1.7976931348623157E308">
                     <font><Font size="12.0" /></font>
                  </Label>

               </VBox>

               <Separator />
            </VBox>

            <!-- ═══ BẢNG LỊCH SỬ BID + BIỂU ĐỒ GIÁ ═══ -->
            <VBox VBox.vgrow="ALWAYS" spacing="0.0">
               <TabPane tabClosingPolicy="UNAVAILABLE"
                        VBox.vgrow="ALWAYS" minHeight="280.0">

                  <Tab text="📋 Phiên này">
                     <TableView fx:id="tableBidHistory"
                                stylesheets="@../../CSS/TableView.css"
                                VBox.vgrow="ALWAYS" minHeight="240.0">
                        <columns>
                           <TableColumn fx:id="col_bid_bidder" text="Người đặt"   prefWidth="160.0" />
                           <TableColumn fx:id="col_bid_amount" text="Giá đặt (₫)" prefWidth="150.0" />
                           <TableColumn fx:id="col_bid_time"   text="Thời gian"   prefWidth="170.0" />
                        </columns>
                        <columnResizePolicy>
                           <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                     </TableView>
                  </Tab>

                  <Tab text="📂 Toàn bộ lịch sử">
                     <TableView fx:id="tableAllBidHistory"
                                stylesheets="@../../CSS/TableView.css"
                                VBox.vgrow="ALWAYS" minHeight="240.0">
                        <columns>
                           <TableColumn fx:id="col_all_bidder" text="Người đặt"   prefWidth="160.0" />
                           <TableColumn fx:id="col_all_amount" text="Giá đặt (₫)" prefWidth="150.0" />
                           <TableColumn fx:id="col_all_time"   text="Thời gian"   prefWidth="170.0" />
                        </columns>
                        <columnResizePolicy>
                           <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                     </TableView>
                  </Tab>

                  <Tab text="📈 Biến động giá">
                     <VBox style="-fx-background-color: transparent; -fx-padding: 4px;">
                        <LineChart fx:id="bidPriceChart" VBox.vgrow="ALWAYS" minHeight="320.0"
                                   animated="false" legendVisible="false" createSymbols="true"
                                   style="-fx-background-color: transparent;">
                           <xAxis>
                              <CategoryAxis label="Thời gian" tickLabelRotation="-45" />
                           </xAxis>
                           <yAxis>
                              <NumberAxis label="Giá (₫)" forceZeroInRange="false" />
                           </yAxis>
                        </LineChart>
                     </VBox>
                  </Tab>

               </TabPane>
            </VBox>

         </VBox>
      </HBox>

      <Separator>
         <VBox.margin><Insets top="12.0" bottom="6.0" /></VBox.margin>
      </Separator>

      <!-- Nút điều hướng -->
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <Button text="← Về chi tiết sản phẩm" onAction="#back_to_item_detail">
            <font><Font size="13.0" /></font>
         </Button>
         <Button text="⬡ Về trang tìm kiếm" onAction="#back_to_searching_room">
            <font><Font size="13.0" /></font>
         </Button>
      </HBox>

   </VBox>
   </content>
</ScrollPane>
