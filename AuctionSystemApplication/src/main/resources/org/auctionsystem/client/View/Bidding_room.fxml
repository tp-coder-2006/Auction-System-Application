                              </Button>
                              <Button layoutX="162.0" layoutY="87.0" mnemonicParsing="false" prefWidth="70.0" text="2000k">
                                 <font>
                                    <Font size="15.0" />
                                 </font>
                              </Button>
                              <Button layoutX="92.0" layoutY="110.0" mnemonicParsing="false" prefWidth="70.0" text="5000k">
                                 <font>
                                    <Font size="15.0" />
                                 </font>
                              </Button>
