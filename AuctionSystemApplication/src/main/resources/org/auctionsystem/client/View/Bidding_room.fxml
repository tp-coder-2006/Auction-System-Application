                  </Label>
                  <Region prefHeight="84.0" prefWidth="262.0" />
                  <Button mnemonicParsing="false" onAction="#back_to_searching_room" prefHeight="30.0" prefWidth="115.0" text="Thoát đấu giá">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <HBox.margin>
                        <Insets bottom="10.0" right="10.0" />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
