<HBox alignment="CENTER" prefHeight="800.0" prefWidth="1200.0" styleClass="bidding-root" stylesheets="@../../CSS/BiddingBackground.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.auctionsystem.client.Controller.Bidder.Controller_Bidding_room">
