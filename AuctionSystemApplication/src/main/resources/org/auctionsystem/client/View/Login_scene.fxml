<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" stylesheets="@/org/auctionsystem/CSS/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.auctionsystem.client.Controller.Controller_Login">
   <children>
      <Label alignment="CENTER" layoutX="1.0" layoutY="8.0" prefHeight="0.0" prefWidth="600.0" text="Đăng nhập hệ thống" textAlignment="CENTER">
         <font>
            <Font size="30.0" />
         </font>
      </Label>
      <Button fx:id="log_in_button" layoutX="260.0" layoutY="287.0" mnemonicParsing="false" onAction="#Log_in_condition" text="Đăng nhập" />
      <TextField fx:id="log_in_username" layoutX="219.0" layoutY="112.0" onAction="#Log_in_condition" prefHeight="30.0" prefWidth="159.0">
         <font>
            <Font size="18.0" />
         </font>
      </TextField>
      <Label layoutX="216.0" layoutY="82.0" prefHeight="30.0" prefWidth="166.0" text="Tên đăng nhập">
         <font>
            <Font size="20.0" />
         </font>
      </Label>
      <PasswordField fx:id="log_in_password" layoutX="220.0" layoutY="207.0" onAction="#Log_in_condition" prefHeight="30.0" prefWidth="159.0">
         <font>
            <Font size="18.0" />
         </font>
      </PasswordField>
      <Label layoutX="218.0" layoutY="177.0" prefHeight="30.0" prefWidth="166.0" text="Mật khẩu">
         <font>
            <Font size="20.0" />
         </font>
      </Label>
      <Label fx:id="log_in_password_error" layoutX="218.0" layoutY="247.0" prefHeight="18.0" prefWidth="201.0" textFill="#f40808" wrapText="true" />
      <Hyperlink fx:id="register_link" alignment="CENTER" layoutY="330.0" onAction="#Switching_to_register_scene" prefHeight="26.0" prefWidth="602.0" text="Chưa có tài khoản? Đăng ký ngay" />
      <Label fx:id="log_in_username_error" layoutX="218.0" layoutY="158.0" prefHeight="18.0" prefWidth="201.0" textFill="#f40808" wrapText="true" />
   </children>
</AnchorPane>
