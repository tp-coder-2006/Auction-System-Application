<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.auctionsystem.client.Controller.Controller_Login">
   <children>
      <Label alignment="CENTER" prefHeight="0.0" prefWidth="600.0" text="ĐĂNG NHẬP HỆ THỐNG" textAlignment="CENTER">
         <font>
            <Font size="30.0" />
         </font>
         <VBox.margin>
            <Insets top="20.0" />
         </VBox.margin>
      </Label>
      <Label prefHeight="30.0" prefWidth="190.0" text="Tên đăng nhập">
         <font>
            <Font size="20.0" />
         </font>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </Label>
      <TextField fx:id="log_in_username" maxHeight="-Infinity" maxWidth="-Infinity" onAction="#Log_in_condition" prefHeight="40.0" prefWidth="190.0">
         <font>
            <Font size="18.0" />
         </font>
      </TextField>
      <Label fx:id="log_in_username_error" prefHeight="31.0" prefWidth="162.0" textFill="#f40808" wrapText="true" />
      <Label prefHeight="30.0" prefWidth="190.0" text="Mật khẩu">
         <font>
            <Font size="20.0" />
         </font>
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </Label>
      <PasswordField fx:id="log_in_password" maxHeight="-Infinity" maxWidth="-Infinity" onAction="#Log_in_condition" prefHeight="40.0" prefWidth="190.0">
         <font>
            <Font size="18.0" />
         </font>
      </PasswordField>
      <Label fx:id="log_in_password_error" alignment="TOP_LEFT" prefHeight="41.0" prefWidth="162.0" textFill="#f40808" wrapText="true" />
      <Button fx:id="log_in_button" mnemonicParsing="false" onAction="#Log_in_condition" prefHeight="31.0" prefWidth="85.0" text="Đăng nhập">
         <VBox.margin>
            <Insets top="5.0" />
         </VBox.margin>
      </Button>
      <Hyperlink fx:id="register_link" alignment="CENTER" onAction="#Switching_to_register_scene" prefHeight="26.0" prefWidth="602.0" text="Chưa có tài khoản? Đăng ký ngay">
         <VBox.margin>
            <Insets bottom="20.0" top="10.0" />
         </VBox.margin>
      </Hyperlink>
   </children>
</VBox>
