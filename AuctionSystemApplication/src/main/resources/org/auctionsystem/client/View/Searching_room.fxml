<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="580.0" prefWidth="905.0"
            stylesheets="@../../CSS/style.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.auctionsystem.client.Controller.Bidder.Controller_Searching_room">

   <top>
      <VBox spacing="8.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets top="12.0" left="10.0" right="10.0" bottom="6.0" />
         </padding>
         <children>
            <HBox alignment="CENTER" spacing="8.0">
               <TextField fx:id="field_search"
                          prefHeight="30.0" prefWidth="380.0"
                          promptText="Tìm kiếm sản phẩm...">
                  <font><Font size="14.0" /></font>
               </TextField>
               <Button fx:id="btn_search" text="🔍"
                       prefHeight="30.0" prefWidth="40.0" />
            </HBox>
            <Label text="💡 Double-click vào một sản phẩm để xem chi tiết."
                   style="-fx-text-fill: #888; -fx-font-style: italic;">
               <font><Font size="12.0" /></font>
            </Label>
         </children>
      </VBox>
   </top>

   <center>
      <!-- KHÔNG có onMouseClicked ở đây — double-click xử lý bằng rowFactory trong controller -->
      <TableView fx:id="tableItems"
                 prefHeight="440.0" prefWidth="535.0"
                 stylesheets="@../../CSS/TableView.css"
                 BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="col_name"          text="Tên sản phẩm"     prefWidth="220.0" />
            <TableColumn fx:id="col_current_price" text="Giá hiện tại"      prefWidth="130.0" />
            <TableColumn fx:id="col_time_left"     text="Thời gian còn lại" prefWidth="150.0" />
            <TableColumn fx:id="col_status"        text="Trạng thái"        prefWidth="100.0" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <placeholder>
            <Label text="Không có sản phẩm nào." />
         </placeholder>
      </TableView>
   </center>

   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets top="10.0" bottom="12.0" left="10.0" right="10.0" />
         </padding>
         <Button mnemonicParsing="false"
                 onAction="#Back_to_Dashboard"
                 text="← Quay lại trang chủ">
            <font><Font size="13.0" /></font>
         </Button>
         <Button mnemonicParsing="false"
                 onAction="#Go_to_search_user"
                 text="👤 Tìm kiếm người dùng">
            <font><Font size="13.0" /></font>
         </Button>
      </HBox>
   </bottom>

   <padding>
      <Insets bottom="6.0" left="10.0" right="10.0" />
   </padding>
</BorderPane>
