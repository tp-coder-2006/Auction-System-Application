<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1000.0" stylesheets="@../../CSS/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.auctionsystem.client.Controller.Bidder.Controller_Searching_room">

   <top>
      <VBox spacing="8.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="6.0" left="10.0" right="10.0" top="12.0" />
         </padding>
         <children>
            <HBox alignment="CENTER" prefHeight="46.0" prefWidth="959.0" spacing="1.0">
               <TextField fx:id="field_search" prefHeight="30.0" prefWidth="380.0" promptText="Tìm kiếm sản phẩm...">
                  <font><Font size="16.0" /></font>
               </TextField>
               <Button fx:id="btn_search" prefHeight="30.0" prefWidth="40.0" text="🔍">
                  <font>
                     <Font size="14.0" />
                  </font></Button>
            </HBox>
            <Label style="-fx-text-fill: #888; -fx-font-style: italic;" text="💡 Double-click vào một sản phẩm để xem chi tiết.">
               <font><Font size="12.0" /></font>
            </Label>
         </children>
      </VBox>
   </top>

   <center>
      <!-- KHÔNG có onMouseClicked ở đây — double-click xử lý bằng rowFactory trong controller -->
      <TableView fx:id="tableItems" prefHeight="440.0" prefWidth="535.0" stylesheets="@../../CSS/TableView.css" BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="col_name" prefWidth="220.0" text="Tên sản phẩm" />
            <TableColumn fx:id="col_current_price" prefWidth="130.0" text="Giá hiện tại" />
            <TableColumn fx:id="col_time_left" prefWidth="150.0" text="Thời gian còn lại" />
            <TableColumn fx:id="col_status" prefWidth="100.0" text="Trạng thái" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <placeholder>
            <Label text="Không có sản phẩm nào." />
         </placeholder>
      </TableView>
   </center>

   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="12.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <Button mnemonicParsing="false" onAction="#Back_to_Dashboard" text="← Quay lại trang chủ">
            <font><Font size="18.0" /></font>
         </Button>
         <Button mnemonicParsing="false" onAction="#Go_to_search_user" text="👤 Tìm kiếm người dùng">
            <font><Font size="18.0" /></font>
         </Button>
      </HBox>
   </bottom>

   <padding>
      <Insets bottom="6.0" left="10.0" right="10.0" />
   </padding>
</BorderPane>
