<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.auctionsystem.client.Controller.Seller.Controller_Seller_Dashboard">
   <center>
      <VBox alignment="TOP_CENTER" prefHeight="360.0" prefWidth="580.0">
         <children>
            <Label alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="38.0" prefWidth="580.0" text="Chào mừng đến với hệ thống đấu giá">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            <Button mnemonicParsing="false" prefHeight="51.0" prefWidth="221.0" text="Bán hàng ngay!!!">
               <font>
                  <Font name="System Italic" size="24.0" />
               </font>
            </Button>
            <Label prefHeight="115.0" prefWidth="484.0" text="Để bắt đầu đăng bán sản phẩm, hãy bấm vào nút bên trên" textAlignment="CENTER" wrapText="true">
               <font>
                  <Font name="System Bold Italic" size="24.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </center>
   <top>
      <MenuBar stylesheets="@../../CSS/menu.css" BorderPane.alignment="CENTER">
        <menus>
          <Menu mnemonicParsing="false" text="Trang chủ">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#Go_to_profile" text="Tài khoản" />
                  <MenuItem mnemonicParsing="false" text="Lịch sử bán hàng" />
                  <SeparatorMenuItem mnemonicParsing="false" />
                  <MenuItem mnemonicParsing="false" onAction="#Logging_out" text="Đăng xuất" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Trợ giúp">
            <items>
              <MenuItem mnemonicParsing="false" text="Delete" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
   </top>
</BorderPane>
