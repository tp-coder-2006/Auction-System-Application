<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="724.0" prefWidth="961.0" stylesheets="@../../CSS/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.auctionsystem.client.Controller.Seller.Controller_Seller_Dashboard">
   <center>
      <VBox alignment="TOP_CENTER" prefHeight="360.0" prefWidth="640.0">
         <children>
            <Label alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="6.0" prefWidth="962.0" text="Chào mừng đến với hệ thống đấu giá" textAlignment="CENTER" wrapText="true">
               <font>
                  <Font name="Times New Roman Bold" size="48.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" top="10.0" />
               </VBox.margin>
            </Label>
            <Label text="Hãy tận hưởng thời gian bán hàng tại đây!!">
               <font>
                  <Font name="Times New Roman Bold" size="48.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="50.0" />
               </VBox.margin>
            </Label>
            <HBox alignment="CENTER" prefHeight="316.0" prefWidth="962.0">
               <children>
                  <VBox alignment="CENTER" prefHeight="274.0" prefWidth="616.0" spacing="10.0" styleClass="floating-card" stylesheets="@../../CSS/style.css">
                     <children>
                        <Button mnemonicParsing="false" prefHeight="51.0" prefWidth="266.0" text="Đăng sản phẩm mới!">
                           <font>
                              <Font name="System Italic" size="24.0" />
                           </font>
                        </Button>
                        <Label prefHeight="98.0" prefWidth="499.0" text="Để bắt đầu đăng bán sản phẩm, hãy bấm vào nút bên trên" textAlignment="CENTER" wrapText="true">
                           <font>
                              <Font name="System Bold Italic" size="30.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
               </children>
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </center>
   <top>
      <MenuBar prefHeight="50.0" stylesheets="@../../CSS/menu.css" BorderPane.alignment="CENTER">
        <menus>
          <Menu mnemonicParsing="false" text="Trang chủ">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#Go_to_profile" text="Tài khoản" />
                  <MenuItem mnemonicParsing="false" onAction="#Go_to_selling_history" text="Lịch sử bán hàng" />
                  <SeparatorMenuItem mnemonicParsing="false" />
                  <MenuItem mnemonicParsing="false" onAction="#Logging_out" text="Đăng xuất" />
            </items>
          </Menu>
            <Menu mnemonicParsing="false" text="Sản phẩm">
              <items>
                <MenuItem mnemonicParsing="false" onAction="#Go_to_my_items_scene" text="Quản lý sản phẩm của tôi" />
              </items>
            </Menu>
        </menus>
      </MenuBar>
   </top>
   <bottom>
      <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="18.0" prefWidth="422.0" text="Số dư tài khoản của bạn:" BorderPane.alignment="CENTER">
         <font>
            <Font size="30.0" />
         </font>
         <padding>
            <Insets bottom="10.0" left="10.0" />
         </padding>
      </Label>
   </bottom>
</BorderPane>
