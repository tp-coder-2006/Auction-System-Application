<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" fitToHeight="false"
            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="my-background-pane"
            stylesheets="@../../CSS/background.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.auctionsystem.client.Controller.Seller.Controller_Seller_Item_Detail">

   <content>
      <VBox spacing="0.0" minWidth="920.0" maxWidth="960.0"
            style="-fx-alignment: center;">
         <padding>
            <Insets top="16.0" bottom="24.0" left="24.0" right="24.0" />
         </padding>

         <!-- ── Header: tên + badge trạng thái ── -->
         <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label fx:id="lbl_product_name" styleClass="heading"
                   stylesheets="@../../CSS/Label.css"
                   text="Tên sản phẩm" wrapText="true" HBox.hgrow="ALWAYS">
               <font><Font name="System Bold" size="22.0" /></font>
            </Label>
            <Label fx:id="lbl_status_badge" styleClass="status-badge"
                   stylesheets="@../../CSS/Label.css" text="PENDING" />
         </HBox>

         <Separator>
            <VBox.margin><Insets top="8.0" bottom="12.0" /></VBox.margin>
         </Separator>

         <!-- ── Phần thân: 2 cột ── -->
         <HBox spacing="24.0">

            <!-- ══ Cột trái: ảnh + info ══ -->
            <VBox spacing="10.0" minWidth="280.0" maxWidth="280.0">

               <StackPane styleClass="image-frame" stylesheets="@../../CSS/ImageView.css"
                          prefHeight="200.0" minHeight="200.0">
                  <ImageView fx:id="productImageView"
                             fitHeight="200.0" fitWidth="280.0"
                             pickOnBounds="true" preserveRatio="true" />
               </StackPane>

               <!-- Nút đổi ảnh sản phẩm — chỉ hiển thị và hoạt động với seller/admin -->
               <Button fx:id="btn_change_item_image" mnemonicParsing="false" onAction="#onChangeItemImage"
                       prefWidth="280.0" prefHeight="30.0" visible="false" managed="false"
                       style="-fx-background-color: #f0f4f8; -fx-border-color: #b0bec5; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-cursor: hand;">
                  <graphic>
                     <HBox alignment="CENTER" spacing="6.0">
                        <children>
                           <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                              <image>
                                 <Image url="@../../../../../Icon/camera.png" />
                              </image>
                           </ImageView>
                           <Label text="Đổi ảnh sản phẩm" style="-fx-font-size: 12px; -fx-text-fill: #37474f;" />
                        </children>
                     </HBox>
                  </graphic>
                  <tooltip>
                     <Tooltip text="Nhấn để thay đổi ảnh sản phẩm" />
                  </tooltip>
               </Button>

               <Separator />

               <Label text="Người bán:" styleClass="heading"
                      stylesheets="@../../CSS/Label.css">
                  <font><Font name="System Bold" size="13.0" /></font>
               </Label>
               <Label fx:id="lbl_seller_username"
                      styleClass="heading" stylesheets="@../../CSS/Label.css"
                      wrapText="true" maxWidth="280.0">
                  <font><Font size="13.0" /></font>
               </Label>

               <Separator />

               <Label text="Giá khởi điểm:" styleClass="heading"
                      stylesheets="@../../CSS/Label.css">
                  <font><Font name="System Bold" size="13.0" /></font>
               </Label>
               <Label fx:id="lbl_starting_price"
                      styleClass="heading" stylesheets="@../../CSS/Label.css">
                  <font><Font size="13.0" /></font>
               </Label>

               <Label text="Giá cao nhất hiện tại:" styleClass="heading"
                      stylesheets="@../../CSS/Label.css">
                  <font><Font name="System Bold" size="13.0" /></font>
               </Label>
               <Label fx:id="lbl_current_price"
                      styleClass="heading" stylesheets="@../../CSS/Label.css">
                  <font><Font size="13.0" /></font>
               </Label>

               <Separator />

               <HBox spacing="6.0" alignment="CENTER_LEFT">
                  <Label text="Bắt đầu:" styleClass="heading"
                         stylesheets="@../../CSS/Label.css">
                     <font><Font name="System Bold" size="12.0" /></font>
                  </Label>
                  <Label fx:id="lbl_start_time"
                         styleClass="heading" stylesheets="@../../CSS/Label.css"
                         wrapText="true">
                     <font><Font size="12.0" /></font>
                  </Label>
               </HBox>

               <HBox spacing="6.0" alignment="CENTER_LEFT">
                  <Label text="Kết thúc:" styleClass="heading"
                         stylesheets="@../../CSS/Label.css">
                     <font><Font name="System Bold" size="12.0" /></font>
                  </Label>
                  <Label fx:id="lbl_end_time"
                         styleClass="heading" stylesheets="@../../CSS/Label.css"
                         wrapText="true">
                     <font><Font size="12.0" /></font>
                  </Label>
               </HBox>

               <Separator />

               <Label text="Mô tả:" styleClass="heading"
                      stylesheets="@../../CSS/Label.css">
                  <font><Font name="System Bold" size="12.0" /></font>
               </Label>
               <Label fx:id="lbl_description"
                      styleClass="heading" stylesheets="@../../CSS/Label.css"
                      wrapText="true" maxWidth="280.0">
                  <font><Font size="12.0" /></font>
               </Label>

            </VBox>

            <!-- ══ Cột phải: trạng thái + lịch sử bid ══ -->
            <VBox spacing="12.0" HBox.hgrow="ALWAYS">

               <!-- Thông báo trạng thái (ACTIVE / PENDING / CANCELLED / CLOSED) -->
               <Label fx:id="lbl_status_message"
                      styleClass="error-announcement" stylesheets="@../../CSS/Label.css"
                      wrapText="true" maxWidth="1.7976931348623157E308"
                      visible="false" managed="false">
                  <font><Font size="14.0" /></font>
               </Label>

               <!-- Thông tin đếm ngược nếu item đang ACTIVE (hiển thị thôi, không có nút vào phòng) -->
               <VBox fx:id="active_info_panel" spacing="8.0"
                     visible="false" managed="false">
                  <Label text="⚡ Phiên đấu giá đang diễn ra!"
                         styleClass="heading" stylesheets="@../../CSS/Label.css">
                     <font><Font name="System Bold" size="15.0" /></font>
                  </Label>
                  <Label fx:id="lbl_time_remaining"
                         styleClass="heading" stylesheets="@../../CSS/Label.css"
                         text="⏰ Thời gian còn lại: —">
                     <font><Font name="System Bold" size="13.0" /></font>
                  </Label>
                  <Separator />
               </VBox>

               <!-- ═══ BẢNG LỊCH SỬ BID (2 tab) ═══ -->
               <VBox fx:id="bid_history_panel" spacing="0.0"
                     VBox.vgrow="ALWAYS"
                     visible="false" managed="false">

                  <TabPane tabClosingPolicy="UNAVAILABLE"
                           VBox.vgrow="ALWAYS" minHeight="260.0">

                     <Tab text="📋 Phiên này">
                        <TableView fx:id="tableBidHistory"
                                   stylesheets="@../../CSS/TableView.css"
                                   VBox.vgrow="ALWAYS" minHeight="200.0">
                           <columns>
                              <TableColumn fx:id="col_bid_bidder" text="Người đặt"  prefWidth="160.0" />
                              <TableColumn fx:id="col_bid_amount" text="Giá đặt (₫)" prefWidth="150.0" />
                              <TableColumn fx:id="col_bid_time"   text="Thời gian"   prefWidth="170.0" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </Tab>

                     <Tab text="📂 Toàn bộ lịch sử">
                        <TableView fx:id="tableAllBidHistory"
                                   stylesheets="@../../CSS/TableView.css"
                                   VBox.vgrow="ALWAYS" minHeight="200.0">
                           <columns>
                              <TableColumn fx:id="col_all_bidder" text="Người đặt"  prefWidth="160.0" />
                              <TableColumn fx:id="col_all_amount" text="Giá đặt (₫)" prefWidth="150.0" />
                              <TableColumn fx:id="col_all_time"   text="Thời gian"   prefWidth="170.0" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </Tab>

                  </TabPane>
               </VBox>

            </VBox>
         </HBox>

         <Separator>
            <VBox.margin><Insets top="12.0" bottom="6.0" /></VBox.margin>
         </Separator>

         <!-- Nút quay lại -->
         <HBox alignment="CENTER_RIGHT">
            <Button text="← Quay lại" onAction="#back_to_my_items">
               <font><Font size="13.0" /></font>
            </Button>
         </HBox>

      </VBox>
   </content>
</ScrollPane>
