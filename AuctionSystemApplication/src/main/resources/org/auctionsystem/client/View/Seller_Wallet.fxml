<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="520.0" prefWidth="640.0" spacing="16.0"
      stylesheets="@../../CSS/style.css"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.auctionsystem.client.Controller.Seller.Controller_Seller_Wallet">
   <padding>
      <Insets bottom="20.0" left="24.0" right="24.0" top="16.0" />
   </padding>
   <children>

      <!-- Tiêu đề -->
      <Label text="VÍ CỦA TÔI" alignment="CENTER" maxWidth="1.7976931348623157E308">
         <font><Font name="System Bold" size="26.0" /></font>
      </Label>

      <!-- Card: Số dư hiện tại -->
      <HBox styleClass="floating-card" alignment="CENTER_LEFT" prefHeight="64.0"
            maxWidth="1.7976931348623157E308">
         <padding><Insets bottom="12.0" left="20.0" right="20.0" top="12.0" /></padding>
         <children>
            <VBox spacing="2.0">
               <children>
                  <Label text="Số dư hiện tại" style="-fx-font-size: 13px; -fx-text-fill: #888;" />
                  <Label fx:id="lbl_balance" text="0 ₫"
                         style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #029ef2;" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btn_refresh" text="↻ Làm mới" onAction="#onRefreshBalance"
                    prefWidth="100.0" prefHeight="32.0" style="-fx-font-size: 13px;" />
         </children>
      </HBox>

      <!-- Card: Rút tiền -->
      <VBox styleClass="floating-card" spacing="10.0"
            maxWidth="1.7976931348623157E308">
         <padding><Insets bottom="20.0" left="20.0" right="20.0" top="16.0" /></padding>
         <children>
            <Label text="🏦  Rút tiền về tài khoản ngân hàng"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;" />
            <Separator />

            <Label text="Số tiền muốn rút (₫):"
                   style="-fx-font-size: 13px; -fx-font-weight: bold;" />
            <TextField fx:id="field_withdraw_amount" promptText="Nhập số tiền..."
                       prefHeight="36.0" maxWidth="1.7976931348623157E308" />

            <!-- Gợi ý nhanh -->
            <Label text="Rút nhanh:" style="-fx-font-size: 12px; -fx-text-fill: #666;" />
            <HBox spacing="8.0">
               <children>
                  <Button text="100K"  onAction="#onWithdrawQuick100" prefWidth="70.0" prefHeight="30.0" style="-fx-font-size: 12px;" />
                  <Button text="500K"  onAction="#onWithdrawQuick500" prefWidth="70.0" prefHeight="30.0" style="-fx-font-size: 12px;" />
                  <Button text="1M"    onAction="#onWithdrawQuick1M"  prefWidth="70.0" prefHeight="30.0" style="-fx-font-size: 12px;" />
                  <Button text="5M"    onAction="#onWithdrawQuick5M"  prefWidth="70.0" prefHeight="30.0" style="-fx-font-size: 12px;" />
                  <Button text="Tất cả" onAction="#onWithdrawAll"     prefWidth="70.0" prefHeight="30.0" style="-fx-font-size: 12px;" />
               </children>
            </HBox>

            <Label text="Ghi chú (tuỳ chọn):"
                   style="-fx-font-size: 13px; -fx-font-weight: bold;">
               <VBox.margin><Insets top="4.0" /></VBox.margin>
            </Label>
            <TextField fx:id="field_withdraw_note" promptText="Vd: Rút về tài khoản Vietcombank..."
                       prefHeight="36.0" maxWidth="1.7976931348623157E308" />

            <Button fx:id="btn_withdraw" text="✔  Xác nhận rút tiền"
                    onAction="#onWithdraw"
                    prefHeight="40.0" maxWidth="1.7976931348623157E308">
               <VBox.margin><Insets top="8.0" /></VBox.margin>
               <style>
                  -fx-font-size: 14px; -fx-font-weight: bold;
                  -fx-background-color: #e74c3c; -fx-text-fill: white;
                  -fx-background-radius: 6px;
               </style>
            </Button>

            <Label fx:id="lbl_withdraw_status" text="" wrapText="true"
                   maxWidth="1.7976931348623157E308" alignment="CENTER"
                   style="-fx-font-size: 12px;" />
         </children>
      </VBox>

      <!-- Nút điều hướng -->
      <HBox alignment="CENTER" spacing="16.0" maxWidth="1.7976931348623157E308">
         <children>
            <Button text="📋  Lịch sử giao dịch"
                    onAction="#onViewHistory"
                    prefHeight="36.0" prefWidth="200.0"
                    style="-fx-font-size: 13px;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="← Quay lại trang chủ"
                    onAction="#onBack"
                    prefHeight="36.0" prefWidth="185.0"
                    style="-fx-font-size: 13px;" />
         </children>
      </HBox>

   </children>
</VBox>
