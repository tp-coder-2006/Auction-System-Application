<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="750.0" prefWidth="1000.0" spacing="20.0" stylesheets="@../../CSS/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.auctionsystem.client.Controller.Seller.Controller_Selling_History">
   <children>
      <Label prefHeight="34.0" prefWidth="970.0" text="LỊCH SỬ BÁN HÀNG" wrapText="true">
         <font>
            <Font name="Times New Roman Bold" size="30.0" />
         </font>
      </Label>
      <TableView fx:id="tableSellingHistory" prefHeight="467.0" prefWidth="845.0" stylesheets="@../../CSS/TableView.css" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="col_name" prefWidth="75.0" text="Tên sản phẩm" />
          <TableColumn fx:id="col_buyer" prefWidth="75.0" text="Người mua" />
            <TableColumn fx:id="col_sold_price" prefWidth="75.0" text="Giá đã bán" />
            <TableColumn fx:id="col_sold_time" prefWidth="75.0" text="Thời điểm bán" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox alignment="CENTER" prefHeight="39.0" prefWidth="845.0" VBox.vgrow="NEVER">
         <children>
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#back_to_seller_dashboard" text="← Quay lại trang chủ">
               <font>
                  <Font size="18.0" />
               </font>
            </Button>
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="30.0" right="30.0" top="30.0" />
   </padding>
</VBox>
