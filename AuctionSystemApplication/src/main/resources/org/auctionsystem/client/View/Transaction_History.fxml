<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="750.0" prefWidth="1000.0" spacing="10.0" stylesheets="@../../CSS/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.auctionsystem.client.Controller.Bidder.Controller_Transaction_History">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <children>

      <!-- Tiêu đề -->
      <Label maxWidth="1.7976931348623157E308" text="LỊCH SỬ BIẾN ĐỘNG SỐ DƯ">
         <font><Font name="System Bold" size="30.0" /></font>
      </Label>

      <!-- Thanh filter -->
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label style="-fx-font-size: 14px;" text="Lọc theo loại:">
               <HBox.margin><Insets right="4.0" /></HBox.margin>
            </Label>
            <ComboBox fx:id="combo_filter" prefWidth="180.0" stylesheets="@../../CSS/ComboBox.css" />
            <Button fx:id="btn_filter" onAction="#on_filter" prefWidth="70.0" text="Lọc">
               <font>
                  <Font size="14.0" />
               </font></Button>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lbl_balance" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Số dư: ..." />
         </children>
      </HBox>

      <!-- Bảng -->
      <TableView fx:id="table_transactions" maxWidth="1.7976931348623157E308" stylesheets="@../../CSS/TableView.css" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="col_time" prefWidth="145" text="Thời gian" />
            <TableColumn fx:id="col_type" prefWidth="110" text="Loại" />
            <TableColumn fx:id="col_amount" prefWidth="110" text="Số tiền" />
            <TableColumn fx:id="col_before" prefWidth="110" text="Trước" />
            <TableColumn fx:id="col_after" prefWidth="110" text="Sau" />
            <TableColumn fx:id="col_note" prefWidth="160" text="Ghi chú" />
         </columns>
         <placeholder>
            <Label text="Không có giao dịch nào." />
         </placeholder>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>

      <!-- Nút quay lại -->
      <HBox alignment="CENTER_RIGHT">
         <children>
            <Button fx:id="btn_back" onAction="#on_back" prefHeight="40.0" prefWidth="111.0" text="Quay lại">
               <font>
                  <Font size="18.0" />
               </font></Button>
         </children>
      </HBox>

   </children>
</VBox>
