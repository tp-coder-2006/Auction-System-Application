<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.auctionsystem.client.Controller.Controller_Transaction_History">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <children>

      <!-- Tiêu đề -->
      <Label text="LỊCH SỬ BIẾN ĐỘNG SỐ DƯ" maxWidth="1.7976931348623157E308">
         <font><Font name="System Bold" size="22.0" /></font>
      </Label>

      <!-- Thanh filter -->
      <HBox spacing="10.0" alignment="CENTER_LEFT">
         <children>
            <Label text="Lọc theo loại:" style="-fx-font-size: 14px;">
               <HBox.margin><Insets right="4.0"/></HBox.margin>
            </Label>
            <ComboBox fx:id="combo_filter" prefWidth="180.0" />
            <Button fx:id="btn_filter" text="Lọc" onAction="#on_filter" prefWidth="70.0" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lbl_balance" text="Số dư: ..." style="-fx-font-size: 14px; -fx-font-weight: bold;" />
         </children>
      </HBox>

      <!-- Bảng -->
      <TableView fx:id="table_transactions" VBox.vgrow="ALWAYS" maxWidth="1.7976931348623157E308">
         <columns>
            <TableColumn fx:id="col_time"   text="Thời gian"       prefWidth="145" />
            <TableColumn fx:id="col_type"   text="Loại"            prefWidth="110" />
            <TableColumn fx:id="col_amount" text="Số tiền"         prefWidth="110" />
            <TableColumn fx:id="col_before" text="Trước"           prefWidth="110" />
            <TableColumn fx:id="col_after"  text="Sau"             prefWidth="110" />
            <TableColumn fx:id="col_note"   text="Ghi chú"         prefWidth="160" />
         </columns>
         <placeholder>
            <Label text="Không có giao dịch nào." />
         </placeholder>
      </TableView>

      <!-- Nút quay lại -->
      <HBox alignment="CENTER_RIGHT">
         <children>
            <Button fx:id="btn_back" text="Quay lại" onAction="#on_back" prefWidth="100.0" prefHeight="30.0" />
         </children>
      </HBox>

   </children>
</VBox>
